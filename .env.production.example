# Production env for docker-compose.prod.yml. Copy to .env.production on the
# server and fill in. DATABASE_URL and REDIS_URL are set by compose — do not
# put them here.

NODE_ENV=production
DOMAIN=api.amana.example            # the hostname whose A record points here
PUBLIC_API_URL=https://api.amana.example
PUBLIC_WEB_URL=https://amana.example
CORS_ORIGINS=https://amana.example

POSTGRES_PASSWORD=                  # generate: openssl rand -hex 24 (Docker route only)

# --- datastores -----------------------------------------------------------
# On the Docker route compose sets these for you. On LiteHost Premium (no
# bundled Postgres/Redis) point them at Neon and Upstash:
#
#   DATABASE_URL         Neon POOLED connection string, keep ?sslmode=require
#   DIRECT_DATABASE_URL  Neon DIRECT (unpooled) string — migrations only
#   REDIS_URL            Upstash rediss:// URL (TLS). Note the double "s".
#
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/amana?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/amana?sslmode=require
# REDIS_URL=rediss://default:xxxxx@yyyy.upstash.io:6379
# REDIS_PREFIX=amana   # required if that Redis is shared with another project

# --- secrets: generate, never reuse the dev values ---
JWT_SECRET=                         # openssl rand -hex 32
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=                   # openssl rand -hex 32; guards POST /payouts

# MUST be false in production: when true the OTP is returned in the API
# response, so anyone can sign in as any phone number.
OTP_DEBUG=false

# --- providers ---
PAYMENT_MODE=fake                   # flip to paga once the account is verified
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HMAC_KEY=
PAGA_WEBHOOK_SECRET=
PAGA_PAYER_FEE_SHARE=1

DELIVERY_MODE=fake                  # flip to chowdeck once keys are issued
CHOWDECK_BASE_URL=https://api.chowdeck.com
CHOWDECK_API_KEY=
CHOWDECK_WEBHOOK_SECRET=

GITHUB_WEBHOOK_SECRET=

AI_MODE=heuristic                   # or anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

AUTO_RELEASE_HOURS=24
UNPAID_EXPIRY_HOURS=48
