// Amana data model — PRD section 10.
// One agreement record serves WhatsApp, web and (later) the public API.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Hosted Postgres (Neon, Supabase) hands out a pooled connection string.
  // Migrations need an unpooled one — PgBouncer breaks the advisory locks
  // Prisma takes during DDL. Falls back to DATABASE_URL when unset.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- enums

/// PRD section 5. Money moves only from RELEASABLE.
enum AgreementStatus {
  DRAFT
  AWAITING_PAYMENT
  FUNDED
  IN_PROGRESS
  EVIDENCE_IN
  RELEASABLE
  PAYING_OUT
  COMPLETED
  DISPUTED
  REFUNDED
  EXPIRED
}

enum AgreementType {
  TRADE
  MILESTONE
}

enum Channel {
  WHATSAPP
  WEB
  API
  DISCORD
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  RELEASABLE
  PAYING_OUT
  PAID
  REJECTED
  DISPUTED
}

enum EvidenceType {
  CHOWDECK
  GITHUB
  UPLOAD
  BUYER_CONFIRM
  BUYER_PROBLEM
  ADMIN_NOTE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  MISMATCHED
  FAILED
  EXPIRED
}

enum PayoutStatus {
  PENDING
  SENT
  FAILED
  REVERSED
}

enum LedgerEntryType {
  HELD
  RELEASED
  REFUNDED
}

enum DeliveryStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RULED_RELEASE
  RULED_REFUND
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// ---------------------------------------------------------------- tables

model User {
  id         String   @id @default(uuid())
  phone      String   @unique
  name       String?
  email      String?
  isAdmin    Boolean  @default(false)
  isSeller   Boolean  @default(false)
  isBuyer    Boolean  @default(false)
  payoutRef  String? // Destination account number for payouts
  payoutBankUuid String? // Paga's UUID for that bank (required by depositToBank)
  verifiedAt DateTime?
  createdAt  DateTime @default(now())

  agreementsAsPayer  Agreement[]    @relation("payer")
  agreementsAsPayee  Agreement[]    @relation("payee")
  notifications      Notification[]
  otps               OtpCode[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("otp_codes")
}

model Agreement {
  id           String          @id @default(uuid())
  type         AgreementType
  status       AgreementStatus @default(DRAFT)
  payerId      String
  payer        User            @relation("payer", fields: [payerId], references: [id])
  payeeId      String
  payee        User            @relation("payee", fields: [payeeId], references: [id])
  title        String
  totalAmount  BigInt // minor units (kobo)
  currency     String          @default("NGN")
  version      Int             @default(1)
  disputeLock  Boolean         @default(false)
  createdVia   Channel         @default(WEB)
  autoReleaseHours Int?
  releasableAt DateTime? // set when the confirmation window opens
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  terms         AgreementTerms[]
  milestones    Milestone[]
  evidence      Evidence[]
  payments      Payment[]
  payouts       Payout[]
  deliveries    Delivery[]
  disputes      Dispute[]
  auditLog      AuditLog[]
  ledgerEntries LedgerEntry[]

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@map("agreements")
}

model AgreementTerms {
  id                String    @id @default(uuid())
  agreementId       String
  agreement         Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  version           Int
  termsJson         Json
  aiGenerated       Boolean   @default(false)
  approvedByPayerAt DateTime?
  approvedByPayeeAt DateTime?
  createdAt         DateTime  @default(now())

  @@unique([agreementId, version])
  @@map("agreement_terms")
}

model Milestone {
  id             String          @id @default(uuid())
  agreementId    String
  agreement      Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  position       Int
  title          String
  amount         BigInt
  conditionsJson Json // e.g. ["tests_pass","client_approval"]
  verification   String          @default("client_approval")
  status         MilestoneStatus @default(PENDING)
  testsPassedAt  DateTime?
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  evidence Evidence[]
  payouts  Payout[]

  @@index([agreementId])
  @@map("milestones")
}

model Evidence {
  id          String       @id @default(uuid())
  agreementId String
  agreement   Agreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  type        EvidenceType
  payloadJson Json
  source      String
  externalId  String? // dedupe key for webhook-sourced evidence
  receivedAt  DateTime     @default(now())

  // Scoped per agreement: webhook events are already deduped in webhook_events,
  // and two different agreements may legitimately cite the same PR URL.
  @@unique([agreementId, type, externalId])
  @@index([agreementId])
  @@map("evidence")
}

model Payment {
  id              String        @id @default(uuid())
  agreementId     String
  agreement       Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  pagaReference   String        @unique
  amount          BigInt
  currency        String        @default("NGN")
  status          PaymentStatus @default(PENDING)
  providerTxnId   String?
  rawCallbackJson Json?
  confirmedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([agreementId])
  @@map("payments")
}

model Payout {
  id              String       @id @default(uuid())
  agreementId     String
  agreement       Agreement    @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id])
  idempotencyKey  String       @unique
  amount          BigInt
  recipient       String
  status          PayoutStatus @default(PENDING)
  providerRef     String?
  failureReason   String?
  rawResponseJson Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([agreementId])
  @@map("payouts")
}

/// Internal ledger — what is held and owed to whom (PRD section 7.3).
model LedgerEntry {
  id          String          @id @default(uuid())
  agreementId String
  agreement   Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  type        LedgerEntryType
  amount      BigInt
  reference   String
  memo        String?
  createdAt   DateTime        @default(now())

  @@index([agreementId])
  @@map("ledger_entries")
}

model Delivery {
  id                 String         @id @default(uuid())
  agreementId        String
  agreement          Agreement      @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  chowdeckDeliveryId String         @unique
  status             DeliveryStatus @default(CREATED)
  trackingUrl        String?
  pickupAddress      String?
  dropoffAddress     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([agreementId])
  @@map("deliveries")
}

model Dispute {
  id          String        @id @default(uuid())
  agreementId String
  agreement   Agreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  milestoneId String?
  openedBy    String
  reason      String
  status      DisputeStatus @default(OPEN)
  ruling      String?
  ruledBy     String?
  ruledAt     DateTime?
  createdAt   DateTime      @default(now())

  @@index([agreementId])
  @@map("disputes")
}

/// Append-only. Every transition writes who, what, when and the evidence reference.
model AuditLog {
  id          String    @id @default(uuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actor       String // user id, "system", "paga", "chowdeck", "github", "admin:<id>"
  action      String
  fromStatus  String?
  toStatus    String?
  evidenceRef String?
  metaJson    Json?
  createdAt   DateTime  @default(now())

  @@index([agreementId])
  @@map("audit_log")
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementId String?
  channel     String // whatsapp | discord | log
  template    String
  payloadJson Json?
  status      NotificationStatus @default(QUEUED)
  error       String?
  createdAt   DateTime           @default(now())
  sentAt      DateTime?

  @@index([userId])
  @@map("notifications")
}

/// Raw webhook bodies kept for debugging and audit (PRD section 7 reliability checklist).
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String // paga | chowdeck | github | whatsapp
  externalId  String?
  signatureOk Boolean
  rawBody     Json
  headers     Json?
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@unique([provider, externalId])
  @@index([provider])
  @@map("webhook_events")
}
