# --- core ---
NODE_ENV=development
PORT=3001
PUBLIC_WEB_URL=http://localhost:3000
DATABASE_URL=postgresql://amana:amana@localhost:5432/amana?schema=public
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=amana        # namespaces queue keys; set if the Redis is shared

# --- auth ---
JWT_SECRET=change-me-in-staging
JWT_EXPIRES_IN=7d
OTP_DEBUG=true            # log the OTP instead of sending it (dev only)

# --- money mode ---
# fake = "paying" instantly marks FUNDED and "payout" writes a fake success (PRD s.12 handoff #4)
PAYMENT_MODE=fake         # fake | paga
# Paga is two products with two hosts: Collect takes money in, Business pays out.
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com   # live: https://collect.paga.com
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com        # live: https://www.mypaga.com
PAGA_PUBLIC_KEY=          # portal: Manage Account -> Manage API Keys
PAGA_SECRET_KEY=
PAGA_HMAC_KEY=
PAGA_WEBHOOK_SECRET=
# Public HTTPS origin Paga can reach, for payment and payout callbacks.
PUBLIC_API_URL=

# --- delivery ---
DELIVERY_MODE=fake        # fake | chowdeck
CHOWDECK_BASE_URL=https://api.chowdeck.com
CHOWDECK_API_KEY=         # dashboard: Settings -> Developer Settings
CHOWDECK_WEBHOOK_SECRET=  # same page; verifies x-chowdeck-signature

# --- evidence ---
GITHUB_WEBHOOK_SECRET=

# --- AI compiler ---
AI_MODE=heuristic         # heuristic | anthropic | openrouter
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OpenRouter fronts many models (Claude included) on one bill.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- email (login codes) ---
# Without these the code is only written to the server log.
RESEND_API_KEY=
RESEND_FROM=Amana <noreply@favoursunday.dev>

# --- internal ---
INTERNAL_API_KEY=dev-internal-key   # guards POST /payouts (backend only)
AUTO_RELEASE_HOURS=24
UNPAID_EXPIRY_HOURS=48
